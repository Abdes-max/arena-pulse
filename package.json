{
  "name": "arena-pulse",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "scripts": {
    "ng": "ng",
    "dev": "concurrently -n public-web,admin-web,api -c blue,green,yellow \"npm:dev:public-web\" \"npm:dev:admin-web\" \"npm:dev:api\"",
    "dev:public-web": "ng serve public-web",
    "dev:admin-web": "ng serve admin-web --port 4300",
    "dev:api": "npm --prefix apps/api run start:dev",
    "build": "ng build public-web && ng build admin-web && npm run build:api",
    "build:public-web": "ng build public-web",
    "build:admin-web": "ng build admin-web",
    "build:api": "npm --prefix apps/api run build",
    "test": "ng test public-web --watch=false && ng test admin-web --watch=false && npm run test:api",
    "test:public-web": "ng test public-web --watch=false",
    "test:admin-web": "ng test admin-web --watch=false",
    "test:api": "npm --prefix apps/api run test",
    "test:api:e2e": "npm --prefix apps/api run test:e2e",
    "lint": "ng lint public-web && ng lint admin-web && npm run lint:api",
    "lint:public-web": "ng lint public-web",
    "lint:admin-web": "ng lint admin-web",
    "lint:api": "npm --prefix apps/api run lint",
    "e2e": "playwright test",
    "format": "prettier --write \"apps/{public-web,admin-web}/**/*.{ts,html,scss}\"",
    "format:check": "prettier --check \"apps/{public-web,admin-web}/**/*.{ts,html,scss}\"",
    "verify": "npm run format:check && npm run lint && npm run build && npm run test"
  },
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.0",
    "angular-eslint": "22.1.0",
    "concurrently": "^9.1.0",
    "eslint": "^10.6.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8"
  }
}
