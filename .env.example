# Copier ce fichier en .env (non versionné) et renseigner les valeurs locales.
# Voir docs/architecture/adr/0002-backend-nestjs-instead-of-spring-boot.md pour le contexte de la stack.

# --- Base de données (PostgreSQL) ---
# Copier cette valeur dans apps/api/.env (fichier local Prisma, non versionné).
DATABASE_URL="postgresql://arena_pulse:change-me@localhost:5432/arena_pulse?schema=public"

# --- API (NestJS) ---
API_PORT=3000
JWT_SECRET=change-me-in-local-env-never-commit-a-real-secret
JWT_EXPIRES_IN=3600s

# --- Stockage objet (compatible S3, local via infra/compose) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=arena-pulse-media

# --- Front-end (URLs consommées par public-web / admin-web) ---
PUBLIC_WEB_API_URL=http://localhost:3000/api/v1
ADMIN_WEB_API_URL=http://localhost:3000/api/v1
