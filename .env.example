# Copier ce fichier en .env (non versionné) et renseigner les valeurs locales.
# Voir docs/architecture/adr/0002-backend-nestjs-instead-of-spring-boot.md pour le contexte de la stack.

# --- Base de données (PostgreSQL, via infra/compose/docker-compose.yml) ---
# Copier cette valeur dans apps/api/.env (fichier local Prisma, non versionné).
# Port hôte 5433 (et non 5432) pour réduire les collisions sur une machine
# qui fait tourner plusieurs projets en parallèle — voir docker-compose.yml.
DATABASE_URL="postgresql://arena_pulse:arena_pulse@localhost:5433/arena_pulse?schema=public"

# --- API (NestJS) ---
API_PORT=3000
JWT_SECRET=change-me-in-local-env-never-commit-a-real-secret
JWT_EXPIRES_IN=3600s

# --- Stockage objet (compatible S3, local via infra/compose, identifiants MinIO) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=arena_pulse
S3_SECRET_KEY=arena_pulse_minio
S3_BUCKET=arena-pulse-media

# --- E-mail de développement (Mailhog, via infra/compose) ---
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Front-end (URLs consommées par public-web / admin-web) ---
PUBLIC_WEB_API_URL=http://localhost:3000/api/v1
ADMIN_WEB_API_URL=http://localhost:3000/api/v1
