# Copier ce fichier en .env (non versionné) et renseigner les valeurs locales.
# Voir docs/architecture/adr/0002-backend-nestjs-instead-of-spring-boot.md pour le contexte de la stack.

# --- Base de données (PostgreSQL, via infra/compose/docker-compose.yml) ---
# Copier cette valeur dans apps/api/.env (fichier local Prisma, non versionné).
# Port hôte 5433 (et non 5432) pour réduire les collisions sur une machine
# qui fait tourner plusieurs projets en parallèle — voir docker-compose.yml.
DATABASE_URL="postgresql://arena_pulse:arena_pulse@localhost:5433/arena_pulse?schema=public"

# --- API (NestJS) ---
API_PORT=3000
JWT_SECRET=change-me-in-local-env-never-commit-a-real-secret
JWT_EXPIRES_IN=3600s
# Durée de vie du refresh token (cookie httpOnly) — le refresh token lui-même
# est une chaîne aléatoire opaque, pas un JWT : pas de secret de signature ici.
JWT_REFRESH_EXPIRES_IN=30d
# Origine autorisée pour les requêtes CORS avec identifiants (cookie refresh) — apps/web en
# local. Accepte une liste séparée par des virgules (voir apps/api/src/main.ts) si besoin
# d'origines supplémentaires (ex. mobile), mais une seule suffit depuis la fusion admin-web/public-web.
CORS_ORIGIN=http://localhost:4200
# Origine de apps/web, utilisée pour construire les liens d'invitation envoyés par email
# (route /accept-invitation/:token, non préfixée par /admin).
ADMIN_WEB_URL=http://localhost:4200

# --- Stockage objet (compatible S3, local via infra/compose, identifiants MinIO) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=arena_pulse
S3_SECRET_KEY=arena_pulse_minio
S3_BUCKET=arena-pulse-media

# --- E-mail de développement (Mailhog, via infra/compose) ---
# 127.0.0.1 plutôt que "localhost" pour éviter une résolution DNS vers une
# adresse IPv6 injoignable sur certaines machines.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# --- Front-end (URLs consommées par public-web / admin-web) ---
PUBLIC_WEB_API_URL=http://localhost:3000/api/v1
ADMIN_WEB_API_URL=http://localhost:3000/api/v1

# --- Fichiers uploadés (logos d'équipe, feat/045-team-logos) ---
# Chemin local (relatif au répertoire de travail de l'API) où les logos sont
# écrits, et servis tels quels sous /uploads (voir main.ts). En production,
# doit pointer vers un volume Docker persistant (docker-compose.prod.yml).
UPLOADS_DIR=./uploads

# --- Paiement (Stripe Checkout, feat/036-player-registration-and-payments) ---
# Voir docs/architecture/adr/0005-player-registration-and-payments.md. Non requis pour démarrer
# l'API : StripeService ne lit ces variables qu'au moment d'une inscription payante réelle
# (catégorie avec registrationFeeCents non nul) ou d'un webhook entrant.
STRIPE_SECRET_KEY=sk_test_change-me
# `stripe listen --forward-to localhost:3000/api/v1/payments/webhook` en local imprime le secret
# à utiliser ici (whsec_...).
STRIPE_WEBHOOK_SECRET=whsec_change-me

# --- Publication payante d'un tournoi, par palier (feat/044-pricing-tiers-and-annual-subscription) ---
# Voir docs/architecture/adr/0006-paid-tournament-publication.md. Paliers basés sur le nombre
# d'équipes uniquement : gratuit jusqu'à FREE_MAX_TEAMS, tarif MID jusqu'à MID_MAX_TEAMS, tarif
# HIGH au-delà (équipes illimitées). Valeurs par défaut = tarification réelle du produit (25€ /
# 80€), pour que le flux de paiement Stripe (test mode) soit exercé par défaut en local, pas
# court-circuité. Mettre les prix à 0 uniquement en local, temporairement, pour tester une
# publication sans passer par Stripe Checkout — ne jamais committer un 0 ici.
TOURNAMENT_PUBLICATION_TIER_FREE_MAX_TEAMS=8
TOURNAMENT_PUBLICATION_TIER_MID_MAX_TEAMS=48
TOURNAMENT_PUBLICATION_TIER_MID_PRICE_CENTS=2500
TOURNAMENT_PUBLICATION_TIER_HIGH_PRICE_CENTS=8000

# --- Abonnement annuel par organisation (feat/044) ---
# Publications illimitées pendant un an, quel que soit le palier. Renouvellement manuel (pas de
# reconduction automatique). Valeur par défaut = tarification réelle du produit (200€/an).
ORGANIZATION_ANNUAL_SUBSCRIPTION_PRICE_CENTS=20000
