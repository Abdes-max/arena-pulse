// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  ORG_ADMIN
  ORG_MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships                 OrganizationMember[]
  refreshTokens               RefreshToken[]
  sentInvitations             Invitation[]              @relation("InvitedBy")
  tournamentAdministratorRoles TournamentAdministrator[]
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     OrganizationMember[]
  invitations Invitation[]
  tournaments Tournament[]
}

model OrganizationMember {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  role           OrganizationRole
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String    @unique
  familyId          String
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model Invitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  role           OrganizationRole
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  invitedById    String
  createdAt      DateTime         @default(now())
  expiresAt      DateTime
  acceptedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([organizationId])
  @@index([email])
}

enum TournamentStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

// Global reference data (not scoped by organization) — seeded, no CRUD in this PR.
model Sport {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tournaments Tournament[]
}

model Tournament {
  id             String           @id @default(uuid())
  organizationId String
  sportId        String
  name           String
  status         TournamentStatus @default(DRAFT)
  startDate      DateTime?
  endDate        DateTime?
  isOnline       Boolean          @default(false)
  archivedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sport          Sport                     @relation(fields: [sportId], references: [id], onDelete: Restrict)
  categories     Category[]
  administrators TournamentAdministrator[]

  @@index([organizationId])
  @@index([sportId])
}

model Category {
  id           String   @id @default(uuid())
  tournamentId String
  name         String
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  divisions  Division[]

  @@unique([tournamentId, name])
}

model Division {
  id         String   @id @default(uuid())
  categoryId String
  name       String
  colorHex   String?
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, name])
}

// Catalog (not a fixed enum) so new permissions can be added without a schema
// migration — 10 seeded rows matching docs/product/roles-and-permissions.md.
model Permission {
  id       String @id @default(uuid())
  key      String @unique
  label    String
  position Int    @default(0)

  administratorGrants TournamentAdministratorPermission[]
}

model TournamentAdministrator {
  id           String   @id @default(uuid())
  tournamentId String
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament  Tournament                          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user        User                                @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions TournamentAdministratorPermission[]

  @@unique([tournamentId, userId])
  @@index([userId])
}

model TournamentAdministratorPermission {
  id                        String @id @default(uuid())
  tournamentAdministratorId String
  permissionId              String

  tournamentAdministrator TournamentAdministrator @relation(fields: [tournamentAdministratorId], references: [id], onDelete: Cascade)
  permission              Permission              @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([tournamentAdministratorId, permissionId])
  @@index([permissionId])
}
