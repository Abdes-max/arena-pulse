// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  ORG_ADMIN
  ORG_MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Null until the "Vérifiez votre email" link is clicked -- register()
  // does not issue a session until then (see AuthService.verifyEmail()).
  // The token itself is never stored in clear text, same pattern as
  // Invitation.tokenHash below: only its SHA-256 hash is persisted.
  emailVerifiedAt            DateTime?
  emailVerificationTokenHash String?   @unique
  emailVerificationExpiresAt DateTime?

  memberships                  OrganizationMember[]
  refreshTokens                RefreshToken[]
  sentInvitations              Invitation[]              @relation("InvitedBy")
  tournamentAdministratorRoles TournamentAdministrator[]
  validatedMatchScores         MatchScore[]              @relation("MatchScoreValidatedBy")
  recordedMatchScores          MatchScore[]              @relation("MatchScoreRecordedBy")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Set only by a super admin (see SuperAdminAuditLog) -- blocks
  // TournamentsService.publish() and OrganizationsService.subscribe() with
  // a clear error, but never blocks member login/read access so the
  // organization can still reach support.
  suspendedAt DateTime?

  members       OrganizationMember[]
  invitations   Invitation[]
  tournaments   Tournament[]
  teamRatings   TeamRating[]
  subscriptions OrganizationSubscription[]
}

model OrganizationMember {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  role           OrganizationRole
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String    @unique
  familyId          String
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

// Platform-wide operator account -- deliberately NOT a role/flag on User.
// User is structurally "member of one or more organizations" (every access
// path goes through OrganizationMember); a cross-organization account
// doesn't fit that shape and mixing the two identities on one row/JWT type
// would risk an org-scoped guard accidentally granting platform-wide
// access. Modeled the same way PlayerAccount is kept fully separate from
// User. No registration endpoint exists for this model anywhere in the API
// -- the only way to create a row is infra/scripts/create-super-admin.mjs,
// run by hand.
model SuperAdminAccount {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens SuperAdminRefreshToken[]
  auditLogs     SuperAdminAuditLog[]
}

// Same rotation-with-family-revocation shape as RefreshToken above, kept as
// a fully separate table/cookie (super_admin_refresh_token) rather than a
// shared one -- mirrors how player-auth's refresh tokens are also modeled
// on their own table, never mixed with organizer sessions.
model SuperAdminRefreshToken {
  id                String    @id @default(uuid())
  superAdminId      String
  tokenHash         String    @unique
  familyId          String
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?

  superAdmin SuperAdminAccount @relation(fields: [superAdminId], references: [id], onDelete: Cascade)

  @@index([superAdminId])
  @@index([familyId])
}

// Doubles as both an audit trail and the annotation store for the "annotate
// a stuck payment" action -- rather than adding a note column on each of
// the three separate payment-bearing models (Registration,
// TournamentPublicationOrder, OrganizationSubscription), a single audit row
// keyed by (targetType, targetId) covers all of them uniformly.
model SuperAdminAuditLog {
  id           String   @id @default(uuid())
  superAdminId String
  action       String
  targetType   String
  targetId     String
  note         String?
  createdAt    DateTime @default(now())

  superAdmin SuperAdminAccount @relation(fields: [superAdminId], references: [id], onDelete: Cascade)

  @@index([superAdminId])
  @@index([targetType, targetId])
}

model Invitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  role           OrganizationRole
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  invitedById    String
  createdAt      DateTime         @default(now())
  expiresAt      DateTime
  acceptedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([organizationId])
  @@index([email])
}

enum TournamentStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

// Visual theme applied to a tournament's public site + slideshow only —
// the /admin dashboard and the marketing site always stay on Ink & Signal
// regardless of what an organizer picks here (docs/design/visual-language.md).
enum PublicTheme {
  INK_SIGNAL
  PULSE_EMBER
  NEON_COURT
  FRESH_PITCH
  CRIMSON_CHARGE
}

// Global reference data (not scoped by organization) — seeded, no CRUD in this PR.
model Sport {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tournaments Tournament[]
}

model Tournament {
  id              String           @id @default(uuid())
  organizationId  String
  sportId         String
  name            String
  slug            String           @unique
  status          TournamentStatus @default(DRAFT)
  startDate       DateTime?
  endDate         DateTime?
  isOnline        Boolean          @default(false)
  teamsCanReferee Boolean          @default(false)
  theme           PublicTheme      @default(INK_SIGNAL)
  // Public path served by the API (e.g. /uploads/tournament-logos/<file>) --
  // see TournamentsService.uploadLogo. Null until an organizer uploads one.
  logoUrl         String?
  // Free-text content shown on the tournament's public "Tournoi" page --
  // null until the organizer fills them in. Markdown-free plain text on
  // purpose (rendered with white-space: pre-line), same as every other
  // organizer-authored text field in this schema.
  description     String?
  rules           String?
  practicalInfo   String?
  archivedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization      Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sport             Sport                        @relation(fields: [sportId], references: [id], onDelete: Restrict)
  categories        Category[]
  administrators    TournamentAdministrator[]
  teams             Team[]
  venues            Venue[]
  referees          Referee[]
  registrations     Registration[]
  publicationOrders TournamentPublicationOrder[]
  sponsors          TournamentSponsor[]

  @@index([organizationId])
  @@index([sportId])
}

model TournamentSponsor {
  id           String   @id @default(uuid())
  tournamentId String
  name         String
  // Public path served by the API (e.g. /uploads/sponsor-logos/<file>) --
  // same upload pattern as Tournament.logoUrl/Team.logoUrl. Null until the
  // organizer uploads one (a sponsor can exist name-only in the meantime).
  logoUrl      String?
  linkUrl      String?
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
}

model Category {
  id                      String   @id @default(uuid())
  tournamentId            String
  name                    String
  position                Int      @default(0)
  // Null = free to join (no online registration/payment step required).
  // Amount in the smallest currency unit (e.g. cents), matching Stripe's
  // own convention -- see docs/architecture/adr/0005-player-registration-and-payments.md.
  registrationFeeCents    Int?
  registrationFeeCurrency String?  @default("eur")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tournament    Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  divisions     Division[]
  teams         Team[]
  phases        CompetitionPhase[]
  registrations Registration[]

  @@unique([tournamentId, name])
}

model Division {
  id         String   @id @default(uuid())
  categoryId String
  name       String
  colorHex   String?
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  teams    Team[]

  @@unique([categoryId, name])
}

model Team {
  id           String   @id @default(uuid())
  tournamentId String
  categoryId   String
  divisionId   String?
  groupId      String?
  name         String
  managerName  String?
  managerEmail String?
  managerPhone String?
  // Public path served by the API (e.g. /uploads/team-logos/<file>) -- see
  // TeamsService.uploadLogo. Null until an organizer uploads one.
  logoUrl      String?
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament        Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  category          Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  division          Division?       @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  group             Group?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  players           Player[]
  homeMatches       Match[]         @relation("MatchHomeTeam")
  awayMatches       Match[]         @relation("MatchAwayTeam")
  forfeitedMatches  Match[]         @relation("MatchForfeitedTeam")
  refereeingMatches MatchOfficial[] @relation("MatchOfficialTeam")
  // Set once a paid/free online registration materializes this team --
  // null for teams an organizer created directly (the pre-existing path).
  registration      Registration?

  @@unique([tournamentId, name])
  @@index([tournamentId])
  @@index([categoryId])
  @@index([groupId])
  @@index([divisionId])
}

// Persistent Glicko-2 rating per (organization, exact team name), carried
// across tournaments within the same organization -- unlike `Team` above,
// which is a fresh row per tournament with no cross-tournament identity.
// Matched by exact name, not a real team identity: renaming a team between
// tournaments starts a fresh rating (see docs/product/assumptions-and-open-questions.md).
model TeamRating {
  id              String   @id @default(uuid())
  organizationId  String
  teamName        String
  rating          Float    @default(1500)
  ratingDeviation Float    @default(350)
  volatility      Float    @default(0.06)
  matchesPlayed   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, teamName])
  @@index([organizationId])
}

model Player {
  id           String   @id @default(uuid())
  teamId       String
  firstName    String
  lastName     String
  jerseyNumber Int?
  isCaptain    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

enum CompetitionPhaseType {
  GROUP_STAGE
  KNOCKOUT
}

model CompetitionPhase {
  id                   String               @id @default(uuid())
  categoryId           String
  name                 String
  type                 CompetitionPhaseType
  position             Int                  @default(0)
  matchDurationMinutes Int                  @default(15)
  breakDurationMinutes Int                  @default(5)
  refereesPerMatch     Int                  @default(1)
  // GROUP_STAGE only (ignored for KNOCKOUT, which has no round-robin
  // fixtures to double) -- see ScheduleGenerationService.generate, which
  // rejects a second generate-schedule call while matches already exist for
  // the phase, so this is read once per "clean" generation rather than
  // toggled after matches exist.
  doubleRoundRobin     Boolean              @default(false)
  // True only for the fictitious GROUP_STAGE phase StructurePresetsService's
  // KNOCKOUT_ONLY branch creates to seed a bracket from (QualificationRule
  // always points from a group's standings, so a "no pools" format still
  // needs one) -- no match is ever generated in it. Lets the admin UI (and
  // BracketsService.generateAllMatches) treat it as "no real pool phase"
  // instead of a genuine one, rather than name-matching KNOCKOUT_ONLY_SEED_NAME.
  isSeedPhase          Boolean              @default(false)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  category                Category                      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  groups                  Group[]
  knockoutBracket         KnockoutBracket?
  incomingRules           QualificationRule[]           @relation("QualificationTargetPhase")
  crossGroupRulesAsSource CrossGroupQualificationRule[] @relation("CrossGroupQualificationSourcePhase")
  crossGroupRulesAsTarget CrossGroupQualificationRule[] @relation("CrossGroupQualificationTargetPhase")

  @@unique([categoryId, name])
}

model Group {
  id        String   @id @default(uuid())
  phaseId   String
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phase              CompetitionPhase    @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  teams              Team[]
  qualificationRules QualificationRule[]
  standingRule       StandingRule?
  matches            Match[]

  @@unique([phaseId, name])
}

model StandingRule {
  id                           String   @id @default(uuid())
  groupId                      String   @unique
  winPoints                    Int      @default(3)
  drawPoints                   Int      @default(1)
  lossPoints                   Int      @default(0)
  tieBreakOrder                String[]
  supplementaryStandingEnabled Boolean  @default(false)
  penaltyShootoutEnabled       Boolean  @default(false)
  // Team IDs the organizer has manually ranked ahead of each other, in
  // order, once every configured tieBreakOrder criterion left them still
  // tied -- consulted as the final tiebreaker instead of alphabetical
  // (StandingsService/standings.util's resolveOrder). Appended to one pick
  // at a time as each successive tied subgroup gets resolved.
  manualTieBreakOrder          String[] @default([])
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model KnockoutBracket {
  id              String   @id @default(uuid())
  phaseId         String   @unique
  name            String
  size            Int
  hasRankingMatch Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  phase   CompetitionPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  matches Match[]
}

model QualificationRule {
  id            String   @id @default(uuid())
  groupId       String
  fromPosition  Int
  toPosition    Int
  targetPhaseId String
  createdAt     DateTime @default(now())

  group       Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  targetPhase CompetitionPhase @relation("QualificationTargetPhase", fields: [targetPhaseId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([targetPhaseId])
}

// Compares teams that finish at the same `position` across every pool of
// `phase` (e.g. every 3rd place) against each other -- rather than one
// pool's own position range like QualificationRule -- and qualifies the
// `bestCount` best of them. A separate model rather than a nullable-groupId
// QualificationRule: that would make fromPosition/toPosition/groupId
// nullable on an already-live table with no clean way to express "required
// unless this is a cross-group rule" in the schema itself.
model CrossGroupQualificationRule {
  id                  String   @id @default(uuid())
  phaseId             String
  position            Int
  bestCount           Int
  targetPhaseId       String
  // Same manual tiebreaker mechanism as StandingRule.manualTieBreakOrder,
  // scoped to this rule's own cross-group candidate pool instead of a
  // single group's.
  manualTieBreakOrder String[] @default([])
  createdAt           DateTime @default(now())

  phase       CompetitionPhase @relation("CrossGroupQualificationSourcePhase", fields: [phaseId], references: [id], onDelete: Cascade)
  targetPhase CompetitionPhase @relation("CrossGroupQualificationTargetPhase", fields: [targetPhaseId], references: [id], onDelete: Cascade)

  @@index([phaseId])
  @@index([targetPhaseId])
}

model Venue {
  id           String   @id @default(uuid())
  tournamentId String
  name         String
  address      String?
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  fields     Field[]

  @@unique([tournamentId, name])
}

model Field {
  id        String   @id @default(uuid())
  venueId   String
  name      String
  surface   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue     Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  timeSlots TimeSlot[]

  @@unique([venueId, name])
}

model TimeSlot {
  id        String   @id @default(uuid())
  fieldId   String
  startTime DateTime
  endTime   DateTime
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  field Field  @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  match Match?

  @@index([fieldId])
}

enum MatchStatus {
  SCHEDULED
  LIVE
  COMPLETED
  POSTPONED
  CANCELLED
  FORFEITED
}

model Match {
  id                String      @id @default(uuid())
  groupId           String?
  knockoutBracketId String?
  bracketSlot       Int?
  isThirdPlaceMatch Boolean     @default(false)
  homeTeamId        String?
  awayTeamId        String?
  // Display-only placeholder shown while the real team above is still
  // unknown (e.g. "1er Poule A" for round 1 before pools finish, "Vainqueur
  // Quart de finale 1" for a later round) -- never parsed back, cleared once
  // the real team is resolved (tryAdvanceRound / tryResolveFirstRound).
  homeSourceLabel   String?
  awaySourceLabel   String?
  timeSlotId        String?     @unique
  forfeitedTeamId   String?
  round             Int
  status            MatchStatus @default(SCHEDULED)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  group           Group?           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  knockoutBracket KnockoutBracket? @relation(fields: [knockoutBracketId], references: [id], onDelete: Cascade)
  homeTeam        Team?            @relation("MatchHomeTeam", fields: [homeTeamId], references: [id], onDelete: SetNull)
  awayTeam        Team?            @relation("MatchAwayTeam", fields: [awayTeamId], references: [id], onDelete: SetNull)
  forfeitedTeam   Team?            @relation("MatchForfeitedTeam", fields: [forfeitedTeamId], references: [id], onDelete: SetNull)
  timeSlot        TimeSlot?        @relation(fields: [timeSlotId], references: [id], onDelete: SetNull)
  officials       MatchOfficial[]
  score           MatchScore?

  @@index([groupId])
  @@index([knockoutBracketId])
}

model MatchOfficial {
  id               String   @id @default(uuid())
  matchId          String
  refereeId        String?
  refereeingTeamId String?
  createdAt        DateTime @default(now())

  match          Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  referee        Referee? @relation(fields: [refereeId], references: [id], onDelete: Cascade)
  refereeingTeam Team?    @relation("MatchOfficialTeam", fields: [refereeingTeamId], references: [id], onDelete: Cascade)

  @@index([matchId])
}

// Kept separate from Match (rather than plain score columns) so the
// provisional/validated distinction and its audit trail (mission §10.1) have
// somewhere to live without overloading Match with scoring-specific fields.
model MatchScore {
  id               String    @id @default(uuid())
  matchId          String    @unique
  homeScore        Int
  awayScore        Int
  homePenaltyScore Int?
  awayPenaltyScore Int?
  isValidated      Boolean   @default(false)
  validatedAt      DateTime?
  validatedById    String?
  recordedById     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  match       Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  validatedBy User? @relation("MatchScoreValidatedBy", fields: [validatedById], references: [id], onDelete: SetNull)
  recordedBy  User? @relation("MatchScoreRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
}

// Catalog (not a fixed enum) so new permissions can be added without a schema
// migration — 10 seeded rows matching docs/product/roles-and-permissions.md.
model Permission {
  id       String @id @default(uuid())
  key      String @unique
  label    String
  position Int    @default(0)

  administratorGrants TournamentAdministratorPermission[]
}

model TournamentAdministrator {
  id           String   @id @default(uuid())
  tournamentId String
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament  Tournament                          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user        User                                @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions TournamentAdministratorPermission[]

  @@unique([tournamentId, userId])
  @@index([userId])
}

model TournamentAdministratorPermission {
  id                        String @id @default(uuid())
  tournamentAdministratorId String
  permissionId              String

  tournamentAdministrator TournamentAdministrator @relation(fields: [tournamentAdministratorId], references: [id], onDelete: Cascade)
  permission              Permission              @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([tournamentAdministratorId, permissionId])
  @@index([permissionId])
}

model Referee {
  id           String   @id @default(uuid())
  tournamentId String
  firstName    String
  lastName     String
  email        String?
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament        Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  officiatedMatches MatchOfficial[]

  @@index([tournamentId])
}

// --- Public player accounts + online registration + payments ---
// (feat/036-player-registration-and-payments, see
// docs/architecture/adr/0005-player-registration-and-payments.md)
//
// PlayerAccount is deliberately separate from User: User is exclusively an
// organizer/collaborator concept (always tied to an OrganizationMember --
// see AuthService.register, which creates a User + Organization together in
// one transaction). A PlayerAccount never belongs to an organization; it
// authenticates on entirely different routes (/api/v1/player-auth/*) with
// its own JWT strategy that rejects an organizer's access token and vice
// versa (both tokens carry a `type` claim precisely to prevent that mixup).

model PlayerAccount {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens PlayerRefreshToken[]
  registrations Registration[]
}

model PlayerRefreshToken {
  id                String    @id @default(uuid())
  playerAccountId   String
  tokenHash         String    @unique
  familyId          String
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?

  playerAccount PlayerAccount @relation(fields: [playerAccountId], references: [id], onDelete: Cascade)

  @@index([playerAccountId])
}

enum RegistrationStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
}

// One registration = one team's entry into one category, submitted by a
// PlayerAccount (the captain/registrant) on the tournament's public site.
// Free categories (registrationFeeCents null on Category) skip Stripe
// entirely and go straight to PAID with amountCents 0. `team`/`players`
// materialize (Team + Player rows, the pre-existing organizer-facing
// models) only once status reaches PAID -- see RegistrationsService.
model Registration {
  id                      String             @id @default(uuid())
  tournamentId            String
  categoryId              String
  playerAccountId         String
  teamName                String
  managerEmail            String
  managerPhone            String?
  status                  RegistrationStatus @default(PENDING_PAYMENT)
  amountCents             Int
  currency                String
  stripeCheckoutSessionId String?            @unique
  stripePaymentIntentId   String?
  teamId                  String?            @unique
  createdAt               DateTime           @default(now())
  paidAt                  DateTime?

  tournament    Tournament           @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  category      Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  playerAccount PlayerAccount        @relation(fields: [playerAccountId], references: [id], onDelete: Cascade)
  team          Team?                @relation(fields: [teamId], references: [id], onDelete: SetNull)
  players       RegistrationPlayer[]

  @@index([tournamentId])
  @@index([categoryId])
  @@index([playerAccountId])
}

// The roster submitted at registration time -- copied into real Player rows
// (linked to the materialized Team) once the registration reaches PAID.
model RegistrationPlayer {
  id             String @id @default(uuid())
  registrationId String
  firstName      String
  lastName       String
  jerseyNumber   Int?

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
}

// --- Paid tournament publication (feat/039-paid-tournament-publication, see
// docs/architecture/adr/0006-paid-tournament-publication.md) ---

enum TournamentPublicationOrderStatus {
  PENDING_PAYMENT
  PAID
}

// Gates the DRAFT -> PUBLISHED transition behind a one-time Stripe payment.
// Unlike Registration, this never materializes anything new once PAID -- the
// Tournament row already exists -- it only unlocks TournamentsService.publish.
// One row per publish attempt; once one row for a tournament reaches PAID,
// later publish() calls skip payment entirely (no re-billing on republish).
model TournamentPublicationOrder {
  id                      String                           @id @default(uuid())
  tournamentId            String
  status                  TournamentPublicationOrderStatus @default(PENDING_PAYMENT)
  categoriesCount         Int
  teamsCount              Int
  amountCents             Int
  currency                String
  stripeCheckoutSessionId String?                          @unique
  stripePaymentIntentId   String?
  createdAt               DateTime                         @default(now())
  paidAt                  DateTime?

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
}

enum OrganizationSubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
}

// feat/044-pricing-tiers-and-annual-subscription: an alternative to paying
// per publication (TournamentPublicationOrder) -- one active row per
// organization at a time covers every tournament it publishes for one year,
// regardless of team count/tier. Deliberately doesn't get touched by
// TournamentsService.publish() once a tournament is PUBLISHED under it: an
// expiring subscription never un-publishes anything already live (see ADR
// 0006's revision) -- it only stops covering *future* publish() calls.
model OrganizationSubscription {
  id                      String                          @id @default(uuid())
  organizationId          String
  status                  OrganizationSubscriptionStatus  @default(PENDING_PAYMENT)
  startsAt                DateTime?
  expiresAt               DateTime?
  amountCents             Int
  currency                String
  stripeCheckoutSessionId String?                         @unique
  stripePaymentIntentId   String?
  createdAt               DateTime                        @default(now())
  paidAt                  DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}
