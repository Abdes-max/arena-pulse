// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  ORG_ADMIN
  ORG_MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships                  OrganizationMember[]
  refreshTokens                RefreshToken[]
  sentInvitations              Invitation[]              @relation("InvitedBy")
  tournamentAdministratorRoles TournamentAdministrator[]
  validatedMatchScores         MatchScore[]              @relation("MatchScoreValidatedBy")
  recordedMatchScores          MatchScore[]              @relation("MatchScoreRecordedBy")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     OrganizationMember[]
  invitations Invitation[]
  tournaments Tournament[]
}

model OrganizationMember {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  role           OrganizationRole
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String    @unique
  familyId          String
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model Invitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  role           OrganizationRole
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  invitedById    String
  createdAt      DateTime         @default(now())
  expiresAt      DateTime
  acceptedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([organizationId])
  @@index([email])
}

enum TournamentStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

// Global reference data (not scoped by organization) — seeded, no CRUD in this PR.
model Sport {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tournaments Tournament[]
}

model Tournament {
  id              String           @id @default(uuid())
  organizationId  String
  sportId         String
  name            String
  slug            String           @unique
  status          TournamentStatus @default(DRAFT)
  startDate       DateTime?
  endDate         DateTime?
  isOnline        Boolean          @default(false)
  teamsCanReferee Boolean          @default(false)
  archivedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sport          Sport                     @relation(fields: [sportId], references: [id], onDelete: Restrict)
  categories     Category[]
  administrators TournamentAdministrator[]
  teams          Team[]
  venues         Venue[]
  referees       Referee[]

  @@index([organizationId])
  @@index([sportId])
}

model Category {
  id           String   @id @default(uuid())
  tournamentId String
  name         String
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  divisions  Division[]
  teams      Team[]
  phases     CompetitionPhase[]

  @@unique([tournamentId, name])
}

model Division {
  id         String   @id @default(uuid())
  categoryId String
  name       String
  colorHex   String?
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  teams    Team[]

  @@unique([categoryId, name])
}

model Team {
  id           String   @id @default(uuid())
  tournamentId String
  categoryId   String
  divisionId   String?
  groupId      String?
  name         String
  managerName  String?
  managerEmail String?
  managerPhone String?
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament        Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  category          Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  division          Division?       @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  group             Group?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  players           Player[]
  homeMatches       Match[]         @relation("MatchHomeTeam")
  awayMatches       Match[]         @relation("MatchAwayTeam")
  forfeitedMatches  Match[]         @relation("MatchForfeitedTeam")
  refereeingMatches MatchOfficial[] @relation("MatchOfficialTeam")

  @@unique([tournamentId, name])
  @@index([tournamentId])
  @@index([categoryId])
  @@index([groupId])
  @@index([divisionId])
}

model Player {
  id           String   @id @default(uuid())
  teamId       String
  firstName    String
  lastName     String
  jerseyNumber Int?
  isCaptain    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

enum CompetitionPhaseType {
  GROUP_STAGE
  KNOCKOUT
}

model CompetitionPhase {
  id                   String               @id @default(uuid())
  categoryId           String
  name                 String
  type                 CompetitionPhaseType
  position             Int                  @default(0)
  matchDurationMinutes Int                  @default(15)
  breakDurationMinutes Int                  @default(5)
  refereesPerMatch     Int                  @default(1)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  category        Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  groups          Group[]
  knockoutBracket KnockoutBracket?
  incomingRules   QualificationRule[] @relation("QualificationTargetPhase")

  @@unique([categoryId, name])
}

model Group {
  id        String   @id @default(uuid())
  phaseId   String
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phase              CompetitionPhase    @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  teams              Team[]
  qualificationRules QualificationRule[]
  standingRule       StandingRule?
  matches            Match[]

  @@unique([phaseId, name])
}

model StandingRule {
  id                           String   @id @default(uuid())
  groupId                      String   @unique
  winPoints                    Int      @default(3)
  drawPoints                   Int      @default(1)
  lossPoints                   Int      @default(0)
  tieBreakOrder                String[]
  supplementaryStandingEnabled Boolean  @default(false)
  penaltyShootoutEnabled       Boolean  @default(false)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model KnockoutBracket {
  id              String   @id @default(uuid())
  phaseId         String   @unique
  name            String
  size            Int
  hasRankingMatch Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  phase   CompetitionPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  matches Match[]
}

model QualificationRule {
  id            String   @id @default(uuid())
  groupId       String
  fromPosition  Int
  toPosition    Int
  targetPhaseId String
  createdAt     DateTime @default(now())

  group       Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  targetPhase CompetitionPhase @relation("QualificationTargetPhase", fields: [targetPhaseId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([targetPhaseId])
}

model Venue {
  id           String   @id @default(uuid())
  tournamentId String
  name         String
  address      String?
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  fields     Field[]

  @@unique([tournamentId, name])
}

model Field {
  id        String   @id @default(uuid())
  venueId   String
  name      String
  surface   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue     Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  timeSlots TimeSlot[]

  @@unique([venueId, name])
}

model TimeSlot {
  id        String   @id @default(uuid())
  fieldId   String
  startTime DateTime
  endTime   DateTime
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  field Field  @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  match Match?

  @@index([fieldId])
}

enum MatchStatus {
  SCHEDULED
  LIVE
  COMPLETED
  POSTPONED
  CANCELLED
  FORFEITED
}

model Match {
  id                String      @id @default(uuid())
  groupId           String?
  knockoutBracketId String?
  bracketSlot       Int?
  isThirdPlaceMatch Boolean     @default(false)
  homeTeamId        String?
  awayTeamId        String?
  timeSlotId        String?     @unique
  forfeitedTeamId   String?
  round             Int
  status            MatchStatus @default(SCHEDULED)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  group           Group?           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  knockoutBracket KnockoutBracket? @relation(fields: [knockoutBracketId], references: [id], onDelete: Cascade)
  homeTeam        Team?            @relation("MatchHomeTeam", fields: [homeTeamId], references: [id], onDelete: SetNull)
  awayTeam        Team?            @relation("MatchAwayTeam", fields: [awayTeamId], references: [id], onDelete: SetNull)
  forfeitedTeam   Team?            @relation("MatchForfeitedTeam", fields: [forfeitedTeamId], references: [id], onDelete: SetNull)
  timeSlot        TimeSlot?        @relation(fields: [timeSlotId], references: [id], onDelete: SetNull)
  officials       MatchOfficial[]
  score           MatchScore?

  @@index([groupId])
  @@index([knockoutBracketId])
}

model MatchOfficial {
  id               String   @id @default(uuid())
  matchId          String
  refereeId        String?
  refereeingTeamId String?
  createdAt        DateTime @default(now())

  match          Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  referee        Referee? @relation(fields: [refereeId], references: [id], onDelete: Cascade)
  refereeingTeam Team?    @relation("MatchOfficialTeam", fields: [refereeingTeamId], references: [id], onDelete: Cascade)

  @@index([matchId])
}

// Kept separate from Match (rather than plain score columns) so the
// provisional/validated distinction and its audit trail (mission §10.1) have
// somewhere to live without overloading Match with scoring-specific fields.
model MatchScore {
  id               String    @id @default(uuid())
  matchId          String    @unique
  homeScore        Int
  awayScore        Int
  homePenaltyScore Int?
  awayPenaltyScore Int?
  isValidated      Boolean   @default(false)
  validatedAt      DateTime?
  validatedById    String?
  recordedById     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  match       Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  validatedBy User? @relation("MatchScoreValidatedBy", fields: [validatedById], references: [id], onDelete: SetNull)
  recordedBy  User? @relation("MatchScoreRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
}

// Catalog (not a fixed enum) so new permissions can be added without a schema
// migration — 10 seeded rows matching docs/product/roles-and-permissions.md.
model Permission {
  id       String @id @default(uuid())
  key      String @unique
  label    String
  position Int    @default(0)

  administratorGrants TournamentAdministratorPermission[]
}

model TournamentAdministrator {
  id           String   @id @default(uuid())
  tournamentId String
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament  Tournament                          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user        User                                @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions TournamentAdministratorPermission[]

  @@unique([tournamentId, userId])
  @@index([userId])
}

model TournamentAdministratorPermission {
  id                        String @id @default(uuid())
  tournamentAdministratorId String
  permissionId              String

  tournamentAdministrator TournamentAdministrator @relation(fields: [tournamentAdministratorId], references: [id], onDelete: Cascade)
  permission              Permission              @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([tournamentAdministratorId, permissionId])
  @@index([permissionId])
}

model Referee {
  id           String   @id @default(uuid())
  tournamentId String
  firstName    String
  lastName     String
  email        String?
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament        Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  officiatedMatches MatchOfficial[]

  @@index([tournamentId])
}
