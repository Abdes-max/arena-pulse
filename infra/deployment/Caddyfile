# TLS-terminating reverse proxy for the prod stack (see docker-compose.prod.yml
# and docs/architecture/adr/0004-deployment-strategy.md, "Conséquences": this
# stack only ever served plain HTTP on WEB_HOST_PORT before Caddy was added --
# auth doesn't work correctly without real HTTPS in front of it, since the
# refresh cookie is set Secure). Caddy auto-provisions and renews a Let's
# Encrypt certificate for {$DOMAIN} the first time it starts, as long as DNS
# already points at this host and ports 80/443 are reachable from the
# internet (80 is needed for the ACME HTTP-01 challenge, not just redirects).

{$DOMAIN} {
	encode gzip

	# Security headers (audit finding, feat/175) -- applied here rather than
	# in web's nginx since Caddy is the single TLS-terminating edge for the
	# whole domain (SPA assets AND the /api/ requests nginx proxies through
	# to the api service), so this is the one place that covers both without
	# duplicating the same headers in two config files.
	#
	# CSP is scoped to what the SPA actually loads: 'self' for
	# scripts/connect (Angular bundles + same-origin API, no inline
	# scripts) and 'unsafe-inline' only on style-src (Angular's default
	# ViewEncapsulation injects component styles via <style> tags -- using
	# nonces/hashes instead would need a build-time CSP generator, out of
	# scope here). Stripe Checkout is a full-page redirect
	# (organizations.service.ts's checkoutUrl), never embedded, so it needs
	# no CSP allowance. frame-ancestors 'none' covers clickjacking on its
	# own; X-Frame-Options is kept alongside for browsers that predate CSP2
	# frame-ancestors support.
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self'; connect-src 'self'"
	}

	# web's own nginx (infra/docker/web.nginx.conf) already serves the SPA
	# and reverse-proxies /api/ to the api service on a single origin --
	# Caddy only needs to front that one service, not know about /api/ itself.
	reverse_proxy web:8080
}

# Canonicalize on the bare domain rather than serving both as live origins --
# WEB_PUBLIC_ORIGIN/CORS_ORIGIN is exactly one value, and cookies/CORS are
# origin-exact-match, so a visitor landing on www. would otherwise silently
# fail to authenticate.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
