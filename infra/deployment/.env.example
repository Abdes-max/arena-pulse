# Copy to infra/deployment/.env and fill in real values, then:
#   docker compose -f infra/deployment/docker-compose.prod.yml --env-file infra/deployment/.env up -d --build
# Never commit the filled-in .env file.

# --- Postgres ---
POSTGRES_USER=arena_pulse
POSTGRES_PASSWORD=changeme-generate-a-real-secret
POSTGRES_DB=arena_pulse

# --- API auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=changeme-generate-a-real-secret
JWT_EXPIRES_IN=3600s
JWT_REFRESH_EXPIRES_IN=30d

# --- Public origin ---
# DOMAIN and WEB_PUBLIC_ORIGIN must describe the *same* domain (DOMAIN is
# the bare hostname Caddy requests a Let's Encrypt certificate for;
# WEB_PUBLIC_ORIGIN is the full origin URL used for CORS and the base URL
# baked into organizer-invitation emails) -- DNS for both DOMAIN and
# www.DOMAIN must already point at this host before starting the stack, or
# Caddy's certificate request will fail.
DOMAIN=tournarena.com
WEB_PUBLIC_ORIGIN=https://tournarena.com
# Host-loopback-only port for local smoke-testing (see docker-compose.prod.yml) --
# not the port the public actually uses (that's Caddy on 80/443).
WEB_HOST_PORT=8080

# --- SMTP ---
# SMTP_USER/SMTP_PASSWORD are optional -- leave them unset for an
# unauthenticated relay (e.g. local Mailhog in dev). Set both for an
# authenticated provider -- Brevo (smtp-relay.brevo.com, port 587 STARTTLS)
# is the default here: transactional-email provider, generous free tier,
# SMTP_USER is the login shown on the Brevo SMTP & API page (not your
# account password -- generate a dedicated SMTP key there for
# SMTP_PASSWORD). SMTP_FROM's domain must be verified in Brevo (SPF/DKIM)
# or sends will be rejected/marked as spam.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=changeme-brevo-smtp-login
SMTP_PASSWORD=changeme-brevo-smtp-key
SMTP_FROM=TournArena <no-reply@tournarena.com>
