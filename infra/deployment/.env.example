# Copy to infra/deployment/.env and fill in real values, then:
#   docker compose -f infra/deployment/docker-compose.prod.yml --env-file infra/deployment/.env up -d --build
# Never commit the filled-in .env file.

# --- Postgres ---
POSTGRES_USER=arena_pulse
POSTGRES_PASSWORD=changeme-generate-a-real-secret
POSTGRES_DB=arena_pulse

# --- API auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=changeme-generate-a-real-secret
JWT_EXPIRES_IN=3600s
JWT_REFRESH_EXPIRES_IN=30d

# --- Public origin ---
# DOMAIN and WEB_PUBLIC_ORIGIN must describe the *same* domain (DOMAIN is
# the bare hostname Caddy requests a Let's Encrypt certificate for;
# WEB_PUBLIC_ORIGIN is the full origin URL used for CORS and the base URL
# baked into organizer-invitation emails) -- DNS for both DOMAIN and
# www.DOMAIN must already point at this host before starting the stack, or
# Caddy's certificate request will fail.
DOMAIN=tournarena.com
WEB_PUBLIC_ORIGIN=https://tournarena.com
# Optional -- Kelto Studio's own marketing site (sites/kelto-studio/),
# served static off the same Caddy instance as a second, independent
# domain. Defaults to kelto-studio.fr if left unset. Its DNS (and
# www.KELTO_DOMAIN's) must point at this host before Caddy can provision a
# certificate for it, same prerequisite as DOMAIN above -- but unlike
# DOMAIN, leaving this domain not-yet-ready doesn't affect the rest of the
# stack (see infra/deployment/Caddyfile's comment on that site block).
KELTO_DOMAIN=kelto-studio.fr
# Where .github/workflows/deploy-kelto.yml scp's the static site to on this
# host -- independent of DEPLOY_PATH (this stack's own git checkout), see
# docker-compose.prod.yml's comment on the caddy volume mount for why.
# Must exist before the first Kelto deploy (mkdir -p), see that workflow.
KELTO_SITE_DIR=/opt/kelto-studio
# Host-loopback-only port for local smoke-testing (see docker-compose.prod.yml) --
# not the port the public actually uses (that's Caddy on 80/443).
WEB_HOST_PORT=8080

# --- Fichiers uploadés (logos d'équipe) ---
# Chemin dans le conteneur -- doit correspondre au point de montage du volume
# persistant uploads-data-prod déclaré dans docker-compose.prod.yml, sans
# quoi les logos disparaîtraient à chaque recréation du conteneur api.
UPLOADS_DIR=/app/uploads

# --- SMTP ---
# SMTP_USER/SMTP_PASSWORD are optional -- leave them unset for an
# unauthenticated relay (e.g. local Mailhog in dev). Set both for an
# authenticated provider -- Brevo (smtp-relay.brevo.com, port 587 STARTTLS)
# is the default here: transactional-email provider, generous free tier,
# SMTP_USER is the login shown on the Brevo SMTP & API page (not your
# account password -- generate a dedicated SMTP key there for
# SMTP_PASSWORD). SMTP_FROM's domain must be verified in Brevo (SPF/DKIM)
# or sends will be rejected/marked as spam.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=changeme-brevo-smtp-login
SMTP_PASSWORD=changeme-brevo-smtp-key
SMTP_FROM=TournArena <no-reply@tournarena.com>

# --- Paiement (Stripe Checkout) ---
# Optional -- leave unset to run without payments enabled (docs/architecture/
# adr/0005-player-registration-and-payments.md: StripeService only reads
# these lazily, at the moment of an actual paid registration/publication or
# an incoming webhook). Live keys (sk_live_.../whsec_live_...), from a
# webhook endpoint created for https://${DOMAIN}/api/v1/payments/webhook
# listening only for checkout.session.completed (the only event type this
# app handles -- registrations.service.ts/tournaments.service.ts).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Tarification de la publication d'un tournoi, par palier ---
# Paliers basés sur le nombre d'équipes -- voir
# docs/architecture/adr/0006-paid-tournament-publication.md. Prix par défaut à 0 (gratuit).
TOURNAMENT_PUBLICATION_TIER_FREE_MAX_TEAMS=8
TOURNAMENT_PUBLICATION_TIER_MID_MAX_TEAMS=48
TOURNAMENT_PUBLICATION_TIER_MID_PRICE_CENTS=0
TOURNAMENT_PUBLICATION_TIER_HIGH_PRICE_CENTS=0

# --- Abonnement annuel par organisation ---
# Publications illimitées pendant un an. Renouvellement manuel. Défaut à 0 (gratuit).
ORGANIZATION_ANNUAL_SUBSCRIPTION_PRICE_CENTS=0
