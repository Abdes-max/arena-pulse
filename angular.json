{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "apps",
  "projects": {
    "public-web": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "apps/public-web",
      "sourceRoot": "apps/public-web/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/public-web/src/main.ts",
            "tsConfig": "apps/public-web/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/public-web/public"
              }
            ],
            "styles": ["apps/public-web/src/styles.scss"],
            "stylePreprocessorOptions": {
              "includePaths": ["libs/design-tokens/src/styles"]
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "public-web:build:production"
            },
            "development": {
              "buildTarget": "public-web:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["apps/public-web/**/*.ts", "apps/public-web/**/*.html"],
            "eslintConfig": "apps/public-web/eslint.config.js"
          }
        }
      }
    },
    "admin-web": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "apps/admin-web",
      "sourceRoot": "apps/admin-web/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/admin-web/src/main.ts",
            "tsConfig": "apps/admin-web/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/admin-web/public"
              }
            ],
            "styles": ["apps/admin-web/src/styles.scss"],
            "stylePreprocessorOptions": {
              "includePaths": ["libs/design-tokens/src/styles"]
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "admin-web:build:production"
            },
            "development": {
              "buildTarget": "admin-web:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["apps/admin-web/**/*.ts", "apps/admin-web/**/*.html"],
            "eslintConfig": "apps/admin-web/eslint.config.js"
          }
        }
      }
    },
    "design-tokens": {
      "projectType": "library",
      "root": "libs/design-tokens",
      "sourceRoot": "libs/design-tokens/src",
      "prefix": "ap",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "libs/design-tokens/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "libs/design-tokens/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "libs/design-tokens/tsconfig.spec.json"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["libs/design-tokens/**/*.ts", "libs/design-tokens/**/*.html"],
            "eslintConfig": "libs/design-tokens/eslint.config.js"
          }
        }
      }
    },
    "design-system": {
      "projectType": "library",
      "root": "libs/design-system",
      "sourceRoot": "libs/design-system/src",
      "prefix": "ap",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "libs/design-system/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "libs/design-system/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "libs/design-system/tsconfig.spec.json"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["libs/design-system/**/*.ts", "libs/design-system/**/*.html"],
            "eslintConfig": "libs/design-system/eslint.config.js"
          }
        }
      }
    }
  }
}
